# Environment variables — copy to .env and fill in
# Backend
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=true
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./lumen.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OIDC / Keycloak (set to true to enable auth; currently disabled by default)
OIDC_ENABLED=false
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/lumen
OIDC_CLIENT_ID=lumen-engine
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/callback

# LLM Provider (optional, server-side only)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=